<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Version>0.4.1</Version>
    <ApplicationIcon>../../assets/branding/easyconnection.ico</ApplicationIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <OutputType>WinExe</OutputType>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="..\EasyConnection.Core\EasyConnection.Core.csproj" /></ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../assets/branding/easyconnection.ico" LogicalName="EasyConnection.Icon" />
    <EmbeddedResource Include="../../LICENSE" LogicalName="EasyConnection.License" />
    <EmbeddedResource Include="../../third_party/windows/NOTICE.txt" LogicalName="EasyConnection.ThirdPartyNotices" />
  </ItemGroup>
</Project>
